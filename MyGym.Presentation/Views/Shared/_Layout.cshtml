<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />

    <!-- Main Css -->
    <link rel="stylesheet" href="~/css/style.css" />

    <title>Power fitness | Home</title>

</head>

<body>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <header class="site-header">

        <nav class="navbar navbar-expand-lg bg-white my-3">

            <div class="container">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/logo.jpg"
                         alt="Power Fitness logo" />

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="navbarSupportedContent">

                    <ul class="navbar-nav m-auto mb-2 mb-lg-0 mt-3 mt-lg-0">

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : "") px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door me-1"></i>
                                Home

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Members" ? "active" : "") px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Members"
                               asp-action="Index">

                                <i class="bi bi-people me-1"></i>
                                Members

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Trainer" ? "active" : "") px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Trainers"
                               asp-action="Index">

                                <i class="bi bi-person-arms-up me-1"></i>
                                Trainers

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Session" ? "active" : "") px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Session"
                               asp-action="Index">

                                <i class="bi bi-stopwatch me-1"></i>
                                Sessions

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Plan" ? "active" : "") px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="Plan"
                               asp-action="Index">

                                <i class="bi bi-clipboard2-pulse me-1"></i>
                                Plans

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "MemberShip" ? "active" : "") px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="MemberShip"
                               asp-action="Index">

                                <i class="bi bi-credit-card-2-front me-1"></i>
                                Memberships

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "SessionsSchedule" ? "active" : "") px-3 py-2 mx-2 fw-bolder fs-5"
                               asp-controller="SessionsSchedule"
                               asp-action="Index">

                                <i class="bi bi-calendar3 me-1"></i>
                                Schedule

                            </a>
                        </li>

                        <li class="nav-item">

                            <form asp-action="Logout"
                                  asp-controller="Account"
                                  method="post"
                                  class="d-inline">

                                <button type="submit"
                                        class="btn btn-link nav-link px-3 py-2 mx-2 fw-bolder fs-5 text-black-alternative">

                                    <i class="bi bi-box-arrow-right me-1"></i>
                                    Logout

                                </button>

                            </form>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <div class="page-shell container">

        <main role="main" class="pb-3">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success custom-alert fade show">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger custom-alert fade show">
                    @TempData["ErrorMessage"]
                </div>
            }

            @RenderBody()

        </main>

    </div>

    <footer class="border-top footer text-muted app-footer">

        <div class="container">

            &copy; 2026 - GymApp -
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">

                Privacy

            </a>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const alerts = document.querySelectorAll(".custom-alert");

            alerts.forEach(alertBox => {

                setTimeout(() => {

                    alertBox.classList.remove("show");

                    setTimeout(() => {

                        alertBox.remove();

                    }, 500);

                }, 3000);

            });

        });

    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>